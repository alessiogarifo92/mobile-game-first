<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same for the Google backup and for device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="WebViewChromiumPrefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="WebViewChromiumPrefs.xml" />
    </device-transfer>
</data-extraction-rules>
