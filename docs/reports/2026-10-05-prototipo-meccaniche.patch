index 0000000..338cf51
--- /dev/null
+++ b/scripts/exp-mechanics.ts
@@ -0,0 +1,100 @@
+import { STAGE_SPECS } from './stages/index';
+import { placeSpecial, splitAmmo } from '../src/core/generator';
+import { paintNeeds, parseImage, parseLevel, parseOverlay, type LevelDef } from '../src/core/level';
+import { createRng, shuffle } from '../src/core/rng';
+import { levelWinRate, solve } from '../src/core/solver';
+
+type Variant = string;
+const VARIANTS: Variant[] = (process.env.VARIANTS?.split(',') as Variant[]) ?? ['base', 'brown', 'stone', 'dice', 'lock', 'linked', 'belt1', 'slot-1'];
+const STAGES = (process.env.STAGES ?? '7,8,9,10').split(',').map(Number);
+const SEEDS = Number(process.env.SEEDS ?? 2);
+
+function pick<T>(arr: T[], n: number, rng: () => number): T[] { return shuffle(arr.slice(), rng).slice(0, n); }
+
+const rows: Record<string, { win: number[]; delta: number[]; solvedFirst: number; tries: number; found: number; nodes: number[]; ms: number[] }> = {};
+const baseWin = new Map<string, number>();
+
+for (const st of STAGE_SPECS.filter((s) => STAGES.includes(s.stage))) {
+  st.levels.forEach((spec) => {
+    for (let k = 0; k < SEEDS; k++) {
+      for (const v of VARIANTS) {
+        const r = (rows[v] ??= { win: [], delta: [], solvedFirst: 0, tries: 0, found: 0, nodes: [], ms: [] });
+        const t0 = performance.now();
+        let ok = false;
+        for (let a = 0; a < 30 && !ok; a++) {
+          const seed = spec.seed + 1000 * k + a;
+          const rng = createRng(seed);
+          let image = spec.image.slice();
+          const { width } = parseImage(image);
+          let overlay = spec.special ? placeSpecial(image, spec.special, rng) : (spec.overlay ?? image.map((row) => '.'.repeat(row.length)));
+          const img = image.map((r) => [...r]);
+          const ov = overlay.map((r) => [...r]);
+          const free: [number, number][] = [];
+          img.forEach((row, y) => row.forEach((c, x) => { if (c !== '.' && ov[y]![x] === '.') free.push([x, y]); }));
+          const vr = createRng(seed * 31 + 7);
+          if (v === 'brown' || v === 'brown+stone') for (const [x, y] of pick(free, Math.round(free.length * 0.15), vr)) img[y]![x] = 'K';
+          if (v === 'stone' || v === 'brown+stone') {
+            const f2 = free.filter(([x, y]) => img[y]![x] !== 'K');
+            for (const [x, y] of pick(f2, 5, vr)) { img[y]![x] = '.'; ov[y]![x] = 's'; }
+          }
+          if (v === 'film') {
+            const cand = free.filter(([x, y]) => img[y]![x] !== 'K');
+            for (const [x, y] of pick(cand, Math.max(3, Math.round(free.length * 0.08)), vr)) {
+              const t = ({ R: 1, Y: 2, B: 4, O: 3, G: 6, P: 5 } as Record<string, number>)[img[y]![x]!]!;
+              const opts = [1, 2, 4].filter((p) => (t & p) === 0);
+              ov[y]![x] = String(opts[Math.floor(vr() * opts.length)]);
+            }
+          }
+          let blind: number[] | undefined;
+          if (v === 'blind') {
+            const h = image.length;
+            const lens = [width, h, width, h];
+            const side = Math.floor(vr() * 4);
+            const start = lens.slice(0, side).reduce((a, b) => a + b, 0);
+            const seg = Math.ceil(lens[side]! / 2);
+            const off = Math.floor(vr() * (lens[side]! - seg + 1));
+            blind = Array.from({ length: seg }, (_, i) => start + off + i);
+          }
+          if (v === 'dice') ov.forEach((row) => row.forEach((c, x) => { if (c === 'i') row[x] = 'd'; }));
+          if (v === 'lock') { const p = pick(free, 6, vr); p.slice(0, 2).forEach(([x, y]) => (ov[y]![x] = 'k')); p.slice(2).forEach(([x, y]) => (ov[y]![x] = 'l')); }
+          image = img.map((r) => r.join(''));
+          overlay = ov.map((r) => r.join(''));
+          const { targets } = parseImage(image);
+          const { ice, film } = parseOverlay(overlay, width, targets);
+          const shooters = splitAmmo(paintNeeds(targets, ice, film), spec.ammoChunk);
+          const columns: any[][] = Array.from({ length: spec.columns }, () => []);
+          shuffle(shooters, rng).forEach((s, i) => columns[i % spec.columns]!.push({ ...s }));
+          if (v === 'linked') columns.forEach((col) => col.forEach((s, i) => { if (i < col.length - 1 && i % 3 === 0) s.linked = true; }));
+          const def: LevelDef = {
+            id: spec.seed + k, name: spec.name, stage: st.stage, image, overlay, columns: columns.filter((c) => c.length),
+            slots: v === 'slot-1' ? Math.max(1, spec.slots - 1) : spec.slots,
+            beltCapacity: v === 'belt1' ? 1 : v === 'linked' ? Math.max(2, spec.beltCapacity) : spec.beltCapacity,
+            ...(blind ? { blind } : {}),
+          } as LevelDef;
+          const level = parseLevel(def);
+          r.tries++;
+          const res = solve(level, 200_000);
+          r.nodes.push(res.nodes);
+          if (!res.solvable) continue;
+          if (a === 0) r.solvedFirst++;
+          ok = true;
+          r.found++;
+          const w = levelWinRate(level);
+          r.win.push(w);
+          const key = `${spec.name}:${k}`;
+          if (v === 'base') baseWin.set(key, w);
+          else if (baseWin.has(key)) r.delta.push(w - baseWin.get(key)!);
+        }
+        r.ms.push(performance.now() - t0);
+      }
+    }
+  });
+}
+const mean = (a: number[]) => (a.length ? a.reduce((s, x) => s + x, 0) / a.length : NaN);
+const med = (a: number[]) => { const b = a.slice().sort((x, y) => x - y); return b[Math.floor(b.length / 2)] ?? NaN; };
+console.log('variant | win% mean | Δ pp vs base | win<60% share | levels found | deals solvable % | solver nodes median | ms/level mean');
+for (const [v, r] of Object.entries(rows)) {
+  console.log([v, (mean(r.win) * 100).toFixed(1), v === 'base' ? '-' : (mean(r.delta) * 100).toFixed(1),
+    ((r.win.filter((w) => w < 0.6).length / r.win.length) * 100).toFixed(0), `${r.found}`, ((r.found / r.tries) * 100).toFixed(0),
+    med(r.nodes), mean(r.ms).toFixed(0)].join(' | '));
+}
